# Names only. Do not put secret values in this file.
# Secrets belong in web/.env.local (gitignored) or in the Vercel project's environment.
# Marketplace → Neon injects DATABASE_URL. Storage → Blob → Private sets BLOB_STORE_ID.
# Do not install Vercel Postgres or Vercel KV. Those products are sunset.
# With DATABASE_URL and the Blob variables unset, local `vercel dev` uses PGlite and disk files.

# Hosted Postgres connection string from Neon. Leave unset for local PGlite.
DATABASE_URL=

# Private Blob store id. The store uses short-lived OIDC credentials on Vercel.
BLOB_STORE_ID=

# Legacy private Blob read/write token. Prefer BLOB_STORE_ID from a private store.
BLOB_READ_WRITE_TOKEN=

# Local and non-production only. Set to 1 to return the email sign-in link from the API.
# Production refuses to start if this is set. Do not put it on the hosted project.
BAO_AUTH_STUB=

# Single-owner sign-in. Set both, or neither. Generate the secret locally
# (`openssl rand -hex 32`) and store it as a Vercel Sensitive variable.
# Never commit a value. Sign-in accepts only this email, and only with the secret.
# The desktop pastes the secret once at pairing.
BAO_OWNER_EMAIL=
BAO_INVITE_SECRET=

# Optional local data directories. Ignored on Vercel when the hosted variables above are set.
BAO_PG_DIR=
BAO_BLOB_DIR=
