    {
      "id": "wf-wikipedia-1",
      "index": 1,
      "action": "key",
      "label": "Press Enter",
      "surface": "dom",
      "timeoutMs": 15000,
      "key": "Enter",
      "expect": {
        "kind": "url",
        "match": "Ada_Lovelace",
        "timeoutMs": 15000
