        "nameAttr": "search",
        "tag": "input",
        "label": "Search Wikipedia",
        "cssPath": "#searchInput",
        "xpath": "//*[@id=\"searchInput\"]",
        "path": [
          {
            "role": "search"
          },
          {
            "role": "div"
          },
          {
            "role": "div"
          },
          {
            "role": "form"
          },
          {
            "role": "div"
          },
          {
            "role": "div"
          }
        ],
        "value": "",
        "siblingIndex": 0
      },
      "locators": [
        {
          "kind": "role",
          "role": "input",
          "name": "Search Wikipedia"
        },
        {
          "kind": "text",
          "value": "Search Wikipedia"
        },
        {
          "kind": "css",
          "value": "#searchInput"
        },
        {
          "kind": "xpath",
          "value": "//*[@id=\"searchInput\"]"
        },
        {
          "kind": "anchor",
