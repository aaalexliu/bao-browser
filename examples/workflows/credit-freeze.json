{
  "schema": "bao.workflow/v4",
  "id": "wf-credit-freeze",
  "name": "Credit freeze",
  "startUrl": "http://127.0.0.1:4787/freeze",
  "createdAt": 1,
  "precondition": { "kind": "url", "match": "/freeze", "phase": "auth" },
  "inputs": [
    { "name": "username", "type": "text", "label": "Username", "supply": "saved", "default": "ada" },
    { "name": "password", "type": "secret", "label": "Password", "supply": "must" }
  ],
  "steps": [
    {
      "id": "wf-credit-freeze-0",
      "index": 0,
      "action": "handoff",
      "reason": "sign-in",
      "timeoutMs": 8000,
      "caption": { "text": "Sign in on the site window" },
      "check": { "kind": "url", "match": "/freeze", "timeoutMs": 8000 }
    },
    {
      "id": "wf-credit-freeze-1",
      "index": 1,
      "action": "click",
      "timeoutMs": 4000,
      "caption": { "text": "Click Frozen" },
      "target": {
        "locators": [
          { "kind": "css", "value": "#frozen" },
          { "kind": "role", "role": "radio", "name": "Frozen" }
        ],
        "hint": { "surface": "dom", "role": "radio" }
      },
      "check": {
        "kind": "state",
        "state": "checked",
        "timeoutMs": 2000,
        "locators": [{ "kind": "css", "value": "#frozen" }]
      },
      "readBack": { "source": "text", "match": "Status: none", "timeoutMs": 2000 }
    },
    {
      "id": "wf-credit-freeze-2",
      "index": 2,
      "action": "handoff",
      "reason": "owner-press",
      "timeoutMs": 0,
      "caption": { "text": "Confirm before Apply" },
      "target": {
        "locators": [{ "kind": "role", "role": "button", "name": "Apply" }],
        "hint": { "surface": "dom", "role": "button", "label": "Apply" }
      }
    }
  ]
}
