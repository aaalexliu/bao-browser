{
  "manifest_version": 3,
  "name": "Bao",
  "version": "0.1.0",
  "key": "",
  "description": "Records and replays in this Chrome profile. Talks only to the Bao app on this machine.",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "webNavigation",
    "webRequest",
    "cookies",
    "debugger"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bao",
    "default_popup": "popup.html"
  }
}
