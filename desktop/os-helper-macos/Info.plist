<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>BaoOSHelper</string>
  <key>CFBundleDisplayName</key>
  <string>BaoOSHelper</string>
  <key>CFBundleIdentifier</key>
  <string>dev.bao.oshelper</string>
  <key>CFBundleExecutable</key>
  <string>BaoOSHelper</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSUIElement</key>
  <true/>
  <!-- This helper inherits Bao's identity when bao --run-helper starts it (BAO_HELPER_INHERIT),
       so macOS checks Bao's grants. Older builds always disclaimed and used BaoOSHelper's own
       grant. package-app.sh refuses a helper without this key. -->
  <key>BaoRunsUnderBao</key>
  <true/>
  <key>NSAppleEventsUsageDescription</key>
  <string>The optional bao remote-debugging command opens Chrome's debugging page to change its debugging switch. Chrome agents do not need this permission.</string>
  <key>NSAccessibilityUsageDescription</key>
  <string>The optional native-app MCP driver reads and presses controls in Calculator and TextEdit. The separate bao remote-debugging command changes Chrome's debugging switch. Chrome agents do not need this permission.</string>
  <key>NSScreenCaptureUsageDescription</key>
  <string>The optional native-app MCP driver captures Calculator and TextEdit windows. Chrome agents use page screenshots and do not need this permission.</string>
</dict>
</plist>
