{
  "manifest_version": "0.3",
  "name": "bao",
  "display_name": "Bao",
  "description": "Connect Claude Desktop to Bao's local browser tools and read-only run viewer. Requires Bao.app and Node 24 or newer.",
  "author": { "name": "Bao" },
  "server": {
    "type": "node",
    "entry_point": "server.cjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server.cjs"]
    }
  },
  "tools_generated": true,
  "compatibility": {
    "platforms": ["darwin"]
  }
}
