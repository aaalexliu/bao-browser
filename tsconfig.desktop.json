{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "outDir": "desktop/dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["desktop/src/**/*.ts", "desktop/test/**/*.ts", "src/types.ts", "src/mask.ts", "extension/src/host-grant.ts"]
}
